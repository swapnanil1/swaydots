# Laptop Outputs & Inputs

### Output Configuration
output eDP-1 scale 1.75 {
    resolution 2560x1600@60Hz
    bg $base solid_color
    subpixel rgb
    position 0,0
    adaptive_sync on
}

### Input Configuration
input * {
    xkb_options "altwin:swap_lalt_lwin,caps:swapescape"
}

input type:mouse {
    accel_profile flat
    pointer_accel 0.0
}

input "10182:480:GXT7863:00_27C6:01E0_Touchpad" {
    tap enabled
    natural_scroll disabled
    dwt enabled
    accel_profile adaptive
}

### Power Management
bindswitch --reload lid:on output eDP-1 enable
bindswitch --reload lid:off exec swaylock && systemctl suspend && output eDP-1 disable
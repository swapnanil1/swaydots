# ~/.config/sway/config.d/00-variables
# Variables, Application definitions, Color definitions

### Modifier Key
set $mod Mod4

### Core Applications
set $term alacritty
set $menu wofi --show drun -I -m -p "Run:"
set $browser firefox
set $filemanager thunar

### GUI Utilities
set $sysmonitor gnome-system-monitor
set $network nm-connection-editor
set $volume_control pavucontrol
set $bluetooth blueberry
set $disk_usage baobab

### Clipboard and Screenshot Tools
set $clipboard exec cliphist list | wofi --dmenu -p "Clipboard:" | cliphist decode | wl-copy
set $screenshot_dir ~/Pictures/Screenshots
set $screenshot_full_save exec grim "$screenshot_dir/$(date +'%Y-%m-%d_%H-%M-%S.png')"
set $screenshot_select_save exec grim -g "$(slurp)" "$screenshot_dir/$(date +'%Y-%m-%d_%H-%M-%S.png')"
set $screenshot_window_save exec grim -g "$(swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')" "$screenshot_dir/$(date +'%Y-%m-%d_%H-%M-%S.png')"
set $screenshot_full_copy exec grim - | wl-copy --type image/png
set $screenshot_select_copy exec grim -g "$(slurp)" - | wl-copy --type image/png
set $screenshot_window_copy exec grim -g "$(swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')" - | wl-copy --type image/png

### Movement Keys (One-Handed WASD)
set $left a
set $down s
set $up w
set $right d

### Catppuccin Mocha Color Palette
set $rosewater #f5e0dc
set $flamingo #f2cdcd
set $pink #f5c2e7
set $mauve #cba6f7
